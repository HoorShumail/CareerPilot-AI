# Environment configuration template

# API Settings
PROJECT_NAME="CareerPilot-AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
# Generate a secret key with: openssl rand -hex 32
SECRET_KEY="replace_me_with_a_secure_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="careerpilot"
POSTGRES_PORT=5432
SQLALCHEMY_DATABASE_URI="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Vector Database (ChromaDB)
CHROMA_HOST="localhost"
CHROMA_PORT=8000

# LLM Providers
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_API_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-large"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key" # Optional fallback

# Admin User (Seeded on startup if configured)
FIRST_SUPERUSER="admin@careerpilot.ai"
FIRST_SUPERUSER_PASSWORD="admin_password"
